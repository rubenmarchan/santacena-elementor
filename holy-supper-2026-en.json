     "elements": [
      {
       "id": "b616138",
       "elType": "widget",
       "settings": {
        "html": "<style>\n.hsig { --hsig-title-font: \"Cinzel\", Georgia, serif; }\n</style>\n\n<section class=\"hsig\"\n         data-endpoint=\"/wp-json/wp/v2/media\"\n         data-marker=\"igfeed\"\n         data-count=\"12\"\n         data-profile=\"https://www.instagram.com/holysuppertlotw/\"\n         data-heading=\"Follow us on Instagram\"\n         data-cta=\"View on Instagram\"\n         hidden>\n\n  <div class=\"hsig-inner\">\n    <header class=\"hsig-head\">\n      <h2 class=\"hsig-title\"></h2>\n      <a class=\"hsig-handle\" target=\"_blank\" rel=\"noopener\"></a>\n    </header>\n\n    <ul class=\"hsig-grid\" role=\"list\"></ul>\n  </div>\n\n  <!-- Lightbox. Kept in the DOM (not built on demand) so the markup is\n       reviewable in Elementor and so opening a tile costs no layout work. -->\n  <div class=\"hsig-lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Instagram post\" hidden>\n    <button class=\"hsig-lb-close\" type=\"button\" aria-label=\"Close\">&times;</button>\n    <button class=\"hsig-lb-nav hsig-lb-prev\" type=\"button\" aria-label=\"Previous\">&#8249;</button>\n    <button class=\"hsig-lb-nav hsig-lb-next\" type=\"button\" aria-label=\"Next\">&#8250;</button>\n    <figure class=\"hsig-lb-fig\">\n      <img class=\"hsig-lb-img\" alt=\"\">\n      <figcaption class=\"hsig-lb-cap\">\n        <p class=\"hsig-lb-text\"></p>\n        <a class=\"hsig-lb-link\" target=\"_blank\" rel=\"noopener\"></a>\n      </figcaption>\n    </figure>\n  </div>\n</section>\n\n<style>\n.hsig{--hsig-gap:10px;--hsig-cols:4;--hsig-fg:#1a1a1a;--hsig-muted:#6b6b6b;--hsig-accent:#b8860b;\n  /* Override to give the heading a display face — holysupper.org uses Cinzel.\n     `inherit` here means the page's own font, not the theme's h2 font, which\n     is what an unstyled .hsig-title would otherwise pick up. */\n  --hsig-title-font:inherit;\n  display:block;padding:56px 0;color:var(--hsig-fg);\n  font-family:inherit;-webkit-font-smoothing:antialiased}\n.hsig[hidden]{display:none}\n.hsig-inner{max-width:1180px;margin:0 auto;padding:0 20px;box-sizing:border-box}\n\n.hsig-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;\n  gap:8px;margin:0 0 24px}\n.hsig-title{margin:0;font-family:var(--hsig-title-font);font-size:30px;line-height:1.2;\n  font-weight:600;letter-spacing:.01em}\n.hsig-handle{font-size:15px;color:var(--hsig-accent);text-decoration:none;border-bottom:1px solid transparent;transition:border-color .15s}\n.hsig-handle:hover,.hsig-handle:focus-visible{border-bottom-color:currentColor}\n\n.hsig-grid{display:grid;grid-template-columns:repeat(var(--hsig-cols),1fr);gap:var(--hsig-gap);\n  margin:0;padding:0;list-style:none}\n.hsig-cell{position:relative;margin:0;padding:0}\n\n/* Square tiles without depending on aspect-ratio support: the padding box\n   gives the height, the image is absolutely positioned inside it.\n   Several declarations below look redundant on a bare page and are not: they\n   defend against a theme's global `button {}` rule. Measured in Chrome against\n   the StyleShout stylesheet the SantaCena pages use, a tile without them picks\n   up 36px of side padding, a 16px bottom margin — which shows, because it adds\n   to the row gap and leaves the grid spaced unevenly — and .35em letter-\n   spacing. A class outranks an element selector, so restating the properties\n   here is enough; !important is not needed. */\n.hsig-tile{display:block;position:relative;box-sizing:border-box;\n  width:100%;height:auto;min-width:0;padding:100% 0 0;margin:0;overflow:hidden;\n  border:0;background:#ececec;cursor:pointer;border-radius:2px;\n  font-family:inherit;letter-spacing:normal;text-transform:none}\n.hsig-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\n  display:block;margin:0;transition:transform .45s ease,opacity .3s ease;opacity:0}\n.hsig-tile img.is-ready{opacity:1}\n.hsig-tile:hover img,.hsig-tile:focus-visible img{transform:scale(1.05)}\n.hsig-tile:focus-visible{outline:2px solid var(--hsig-accent);outline-offset:2px}\n\n/* Type badge for reels and carousels — a plain still gives no hint that\n   there's video or more photos behind the tile. */\n.hsig-badge{position:absolute;top:8px;right:8px;width:22px;height:22px;\n  display:flex;align-items:center;justify-content:center;\n  color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5));pointer-events:none}\n.hsig-badge svg{width:100%;height:100%;fill:currentColor}\n\n.hsig-lb{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;\n  background:rgba(0,0,0,.92);padding:24px;box-sizing:border-box}\n.hsig-lb[hidden]{display:none}\n.hsig-lb-fig{margin:0;max-width:900px;max-height:100%;display:flex;flex-direction:column;gap:14px}\n.hsig-lb-img{max-width:100%;max-height:72vh;object-fit:contain;display:block;margin:0 auto;border-radius:2px}\n.hsig-lb-cap{color:#f2f2f2;text-align:center;max-width:640px;margin:0 auto}\n.hsig-lb-text{margin:0 0 10px;font-size:15px;line-height:1.55;white-space:pre-wrap;\n  max-height:22vh;overflow-y:auto}\n.hsig-lb-link{display:inline-block;font-size:14px;color:#fff;text-decoration:none;\n  border:1px solid rgba(255,255,255,.55);border-radius:2px;padding:7px 16px;transition:background .15s}\n.hsig-lb-link:hover,.hsig-lb-link:focus-visible{background:rgba(255,255,255,.14)}\n/* Same defence as .hsig-tile — these are buttons too. */\n.hsig-lb-close,.hsig-lb-nav{position:absolute;box-sizing:border-box;background:none;border:0;\n  color:#fff;cursor:pointer;width:auto;height:auto;min-width:0;line-height:1;padding:12px;margin:0;\n  font-family:inherit;letter-spacing:normal;opacity:.75;transition:opacity .15s}\n.hsig-lb-close:hover,.hsig-lb-nav:hover,\n.hsig-lb-close:focus-visible,.hsig-lb-nav:focus-visible{opacity:1}\n.hsig-lb-close{top:8px;right:12px;font-size:38px}\n.hsig-lb-nav{top:50%;transform:translateY(-50%);font-size:54px}\n.hsig-lb-prev{left:4px}\n.hsig-lb-next{right:4px}\n\n@media (max-width:900px){.hsig{--hsig-cols:3}.hsig-title{font-size:25px}}\n@media (max-width:560px){.hsig{--hsig-cols:2;--hsig-gap:7px;padding:38px 0}\n  .hsig-lb-nav{font-size:40px}.hsig-lb-text{max-height:16vh}}\n\n@media (prefers-reduced-motion:reduce){\n  .hsig-tile img{transition:opacity .3s ease}\n  .hsig-tile:hover img,.hsig-tile:focus-visible img{transform:none}}\n</style>\n\n<script>\n(function () {\n  var root = document.currentScript\n    ? document.currentScript.parentNode.querySelector('.hsig')\n    : document.querySelector('.hsig');\n  if (!root || root.dataset.hsigInit) return;\n  root.dataset.hsigInit = '1';\n\n  var cfg = {\n    endpoint: root.dataset.endpoint || '/wp-json/wp/v2/media',\n    marker:   root.dataset.marker   || 'igfeed',\n    count:    Math.max(1, Math.min(parseInt(root.dataset.count, 10) || 12, 48)),\n    profile:  root.dataset.profile  || '',\n    heading:  root.dataset.heading  || '',\n    cta:      root.dataset.cta      || 'View on Instagram'\n  };\n\n  var grid  = root.querySelector('.hsig-grid');\n  var lb    = root.querySelector('.hsig-lb');\n  var lbImg = root.querySelector('.hsig-lb-img');\n  var lbText= root.querySelector('.hsig-lb-text');\n  var lbLink= root.querySelector('.hsig-lb-link');\n  var items = [];\n  var at    = 0;\n  var lastFocus = null;\n\n  // WordPress's ?search= is a substring match over several fields, so the\n  // response is a superset of the gallery. The real set is whatever has a\n  // title of exactly `<marker>-<instagram id>`, which is what igGallery.js\n  // writes — anything else that merely mentions the marker is discarded.\n  var titleRe = new RegExp('^' + cfg.marker.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '-(\\\\d+)$');\n\n  var url = cfg.endpoint\n    + (cfg.endpoint.indexOf('?') === -1 ? '?' : '&')\n    + 'search=' + encodeURIComponent(cfg.marker)\n    + '&per_page=' + Math.min(cfg.count * 2, 100)\n    + '&orderby=date&order=desc'\n    + '&_fields=' + encodeURIComponent('id,title,date_gmt,caption,description,alt_text,source_url,media_details');\n\n  fetch(url, { credentials: 'omit' })\n    .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })\n    .then(render)\n    .catch(function () { /* leave the section hidden — see the file header */ });\n\n  function render(rows) {\n    items = (rows || [])\n      .map(toItem)\n      .filter(Boolean)\n      // Newest first by the date on the attachment, which sync-ig-gallery.js\n      // sets to the Instagram publish time.\n      //\n      // This used to sort by Instagram media id, on the assumption that ids\n      // grow over time. They do not — measured across 24 real items, that put\n      // a 2024-08-26 post first and left the newest post of all out of the\n      // grid entirely, because the slice below then kept the wrong twelve.\n      // An id says nothing about when something was posted.\n      //\n      // WordPress is already asked for this order, so this mostly re-states\n      // it; it matters for items uploaded before the job started stamping\n      // dates, which fall back to their upload time and would otherwise be\n      // interleaved by accident rather than by date.\n      .sort(function (a, b) { return b.when - a.when; })\n      .slice(0, cfg.count);\n\n    if (!items.length) return;\n\n    var heading = root.querySelector('.hsig-title');\n    if (cfg.heading) heading.textContent = cfg.heading; else heading.remove();\n\n    var handle = root.querySelector('.hsig-handle');\n    if (cfg.profile) { handle.href = cfg.profile; handle.textContent = cfg.cta; }\n    else handle.remove();\n\n    var frag = document.createDocumentFragment();\n    items.forEach(function (item, i) { frag.appendChild(cell(item, i)); });\n    grid.appendChild(frag);\n\n    root.hidden = false;\n    wireLightbox();\n  }\n\n  function toItem(row) {\n    var title = row && row.title && (row.title.rendered || row.title.raw) || '';\n    var m = String(title).trim().match(titleRe);\n    if (!m || !row.source_url) return null;\n\n    // description holds the permalink on its own first line, plus optional\n    // `video` / `carousel:N` markers — see buildDescription in igGallery.js.\n    var meta  = stripHtml(row.description && row.description.rendered || '');\n    var lines = meta.split('\\n').map(function (s) { return s.trim(); }).filter(Boolean);\n    // Matched on instagram.com specifically rather than \"the first line that\n    // looks like a URL\": WordPress prepends its own attachment markup to\n    // description.rendered, and anything it ever contributes here must not be\n    // mistaken for the permalink.\n    var link  = repairDashes(lines.filter(isInstagramUrl)[0] || '');\n\n    return {\n      igId:     m[1],\n      // date_gmt has no timezone marker, and Safari reads such a string as\n      // local time — hence the explicit Z. A row with no parseable date sorts\n      // last rather than poisoning the comparison with NaN.\n      when:     dateOf(row.date_gmt),\n      full:     row.source_url,\n      thumb:    sizedUrl(row, ['medium_large', 'medium', 'thumbnail']) || row.source_url,\n      srcset:   buildSrcset(row),\n      alt:      row.alt_text || '',\n      caption:  stripHtml(row.caption && row.caption.rendered || ''),\n      link:     link,\n      isVideo:  lines.indexOf('video') !== -1,\n      carousel: lines.some(function (l) { return l.indexOf('carousel:') === 0; })\n    };\n  }\n\n  function dateOf(value) {\n    if (!value) return -Infinity;\n    var t = Date.parse(/[Zz]|[+-]\\d{2}:?\\d{2}$/.test(value) ? value : value + 'Z');\n    return isNaN(t) ? -Infinity : t;\n  }\n\n  function isInstagramUrl(line) {\n    return /^https?:\\/\\/(?:www\\.)?instagram\\.com\\/(?:p|reel|reels|tv)\\//i.test(line);\n  }\n\n  // WordPress runs wptexturize over description.rendered, which rewrites a\n  // literal \"--\" as an en dash and \"---\" as an em dash. Instagram shortcodes\n  // are [A-Za-z0-9_-], so a dash character inside a permalink can only have\n  // come from that filter and reversing it is unambiguous. Seen live on\n  // holysupper.org: C--qQ4muM1- was stored correctly and served back as\n  // C&#8211;qQ4muM1-, which is a 404 on Instagram.\n  function repairDashes(url) {\n    return url.replace(/—/g, '---').replace(/–/g, '--');\n  }\n\n  function sizes(row) {\n    return (row.media_details && row.media_details.sizes) || {};\n  }\n\n  function sizedUrl(row, preference) {\n    var s = sizes(row);\n    for (var i = 0; i < preference.length; i++) {\n      if (s[preference[i]] && s[preference[i]].source_url) return s[preference[i]].source_url;\n    }\n    return null;\n  }\n\n  // Lets the browser pick a tile-sized derivative instead of pulling the\n  // full-resolution upload for a thumbnail that is never wider than ~300px.\n  function buildSrcset(row) {\n    var s = sizes(row);\n    var out = [];\n    Object.keys(s).forEach(function (k) {\n      if (k === 'full') return;\n      if (s[k] && s[k].source_url && s[k].width) out.push(s[k].source_url + ' ' + s[k].width + 'w');\n    });\n    return out.join(', ');\n  }\n\n  function cell(item, index) {\n    var li = document.createElement('li');\n    li.className = 'hsig-cell';\n\n    var btn = document.createElement('button');\n    btn.className = 'hsig-tile';\n    btn.type = 'button';\n    btn.setAttribute('aria-label', item.alt || 'Open Instagram post');\n\n    var img = document.createElement('img');\n    // setAttribute rather than the properties: `loading` and `decoding` are\n    // reflected inconsistently (jsdom doesn't implement them at all), and a\n    // lazy-loading hint that silently doesn't apply would mean every tile\n    // fetches up front.\n    img.setAttribute('src', item.thumb);\n    if (item.srcset) {\n      img.setAttribute('srcset', item.srcset);\n      img.setAttribute('sizes', '(max-width:560px) 50vw, (max-width:900px) 33vw, 25vw');\n    }\n    img.setAttribute('alt', item.alt);\n    img.setAttribute('loading', 'lazy');\n    img.setAttribute('decoding', 'async');\n    // Fade in only once decoded, so a slow connection shows the placeholder\n    // rather than a half-painted image.\n    if (img.complete) img.classList.add('is-ready');\n    else img.addEventListener('load', function () { img.classList.add('is-ready'); });\n    // A tile whose file 404s would otherwise sit as a grey square forever.\n    img.addEventListener('error', function () { li.remove(); });\n\n    btn.appendChild(img);\n    if (item.isVideo || item.carousel) btn.appendChild(badge(item));\n    btn.addEventListener('click', function () { open(index); });\n\n    li.appendChild(btn);\n    return li;\n  }\n\n  function badge(item) {\n    var span = document.createElement('span');\n    span.className = 'hsig-badge';\n    span.innerHTML = item.isVideo\n      ? '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>'\n      : '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 1H4a2 2 0 0 0-2 2v13h2V3h11V1zm4 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z\"/></svg>';\n    return span;\n  }\n\n  function open(index) {\n    at = index;\n    lastFocus = document.activeElement;\n    paint();\n    lb.hidden = false;\n    document.addEventListener('keydown', onKey);\n    root.querySelector('.hsig-lb-close').focus();\n  }\n\n  function close() {\n    lb.hidden = true;\n    document.removeEventListener('keydown', onKey);\n    if (lastFocus && lastFocus.focus) lastFocus.focus();\n  }\n\n  function step(delta) {\n    at = (at + delta + items.length) % items.length;\n    paint();\n  }\n\n  function paint() {\n    var item = items[at];\n    lbImg.src = item.full;\n    lbImg.alt = item.alt;\n    lbText.textContent = item.caption;\n    lbText.hidden = !item.caption;\n    if (item.link) { lbLink.href = item.link; lbLink.textContent = cfg.cta; lbLink.hidden = false; }\n    else lbLink.hidden = true;\n\n    var many = items.length > 1;\n    root.querySelector('.hsig-lb-prev').hidden = !many;\n    root.quer
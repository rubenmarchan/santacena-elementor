      {
       "id": "0567459",
       "elType": "widget",
       "settings": {
        "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap');\n\n.wp-news {\n    --font-1        : \"Lora\", Georgia, serif;\n    --font-2        : \"Inter\", -apple-system, BlinkMacSystemFont, sans-serif;\n    --color-1       : hsla(37, 95%, 57%, 1);\n    --color-1-dark  : hsla(37, 95%, 47%, 1);\n    --color-2       : hsla(194, 89%, 26%, 1);\n    --color-2-dark  : hsla(194, 89%, 16%, 1);\n    --color-error-content : hsla(359, 50%, 50%, 1);\n    --color-gray-19 : #161616;\n    --color-gray-15 : #6e6f6f;\n    --color-gray-14 : #838585;\n    --color-gray-11 : #c5c8c7;\n    --color-gray-9  : #dfe1e0;\n    --color-gray-6  : #e9ebeb;\n    --color-gray-3  : #f4f5f5;\n    --color-white   : #ffffff;\n    --color-text    : #161616;\n    --vspace-0_5    : 16px;\n    --vspace-1      : 32px;\n    --vspace-2      : 64px;\n}\n\n/* --- el reproductor del intro ------------------------------------------\n * En el original el bloque .lite-yt es un div de 560px sin márgenes, así que\n * se pegaba a la izquierda aunque el título de arriba vaya centrado; y el\n * <iframe> que lleva dentro mide 720x405 por atributo, o sea que sobresalía\n * del recuadro y el overflow:hidden se lo comía por la derecha. Con esto el\n * recuadro se centra a cualquier ancho y el vídeo llena su propio marco.\n * ---------------------------------------------------------------------- */\n\n\n\n\n/* ===================================================================\n * Paleta tomada de lldmcentenario.org (tema Aromatica, esquema\n * \"scheme_light\"): crema de fondo, tarjetas blancas, filetes arena y\n * el bronce como único acento. Los titulares van en Syne, que es la\n * tipografía de los encabezados de aquel sitio; el cuerpo se queda en\n * Inter, que es lo más parecido a su niveau-grotesk (de Typekit, no\n * se puede enlazar desde aquí).\n * ------------------------------------------------------------------- */\n.wp-news {\n    --news-bg      : #F4F1E7;   /* alter_bg_color */\n    --news-card    : #ffffff;   /* bg_color       */\n    --news-bd      : #D9D4C2;   /* bd_color       */\n    --news-ink     : #0F121C;   /* text_dark      */\n    --news-text    : #6C6E71;   /* text           */\n    --news-soft    : #919296;   /* text_light     */\n    --news-accent  : #9b824a;   /* text_link      */\n    --news-accent-2: #e4b574;   /* alter_link     */\n    --news-font    : \"Syne\", var(--font-2);\n}\n\n/* El retículo tiene que llenar la sección entera: el contenedor original\n   topaba en 1000px (y en 900/800px en las medias de arriba), lo que dejaba\n   tres columnas estrechísimas. Aquí manda el ancho de la ventana y sólo se\n   pone un techo para que en pantallas muy anchas no se descuelgue la vista\n   de un extremo a otro. */\n\n\n@media screen and (min-width: 1900px) {\n    \n}\n\n.wp-news {\n    margin-top : var(--vspace-1);\n    text-align : left;\n    color      : var(--news-text);\n}\n\n/* --- piezas comunes a los dos bloques ----------------------------------- */\n.wp-news__card {\n    display          : flex;\n    flex-direction   : column;\n    background-color : var(--news-card);\n    border           : 1px solid var(--news-bd);\n    overflow         : hidden;\n    transition       : transform .25s ease-out, box-shadow .25s ease-out, border-color .25s ease-out;\n}\n\n.wp-news__card:hover,\n.wp-news__card:focus-within {\n    transform    : translateY(-4px);\n    box-shadow   : 0 16px 32px rgba(15, 18, 28, .10);\n    border-color : var(--news-accent-2);\n}\n\n.wp-news__thumb {\n    position         : relative;\n    display          : block;\n    aspect-ratio     : 16 / 10;\n    background-color : var(--news-bd);\n    overflow         : hidden;\n}\n\n.wp-news__thumb img {\n    width      : 100%;\n    height     : 100%;\n    object-fit : cover;\n    display    : block;\n    transition : transform .4s ease-out;\n}\n\n.wp-news__card:hover .wp-news__thumb img { transform: scale(1.04); }\n\n/* marcador cuando la entrada no trae imagen destacada */\n.wp-news__thumb--empty {\n    display         : flex;\n    align-items     : center;\n    justify-content : center;\n    background      : linear-gradient(135deg, var(--news-ink), #2b2f3d);\n    color           : var(--news-accent-2);\n    font-family     : var(--news-font);\n    font-size       : 24px;\n    font-weight     : 700;\n    letter-spacing  : 3px;\n}\n\n.wp-news__body {\n    display        : flex;\n    flex-direction : column;\n    flex           : 1 1 auto;\n    padding        : 24px 24px 28px;\n}\n\n.wp-news__date {\n    font-family    : var(--font-2);\n    font-size      : 12px;\n    font-weight    : 600;\n    text-transform : uppercase;\n    letter-spacing : 2px;\n    color          : var(--news-accent);\n    margin         : 0 0 10px;\n}\n\n.wp-news__title {\n    font-family    : var(--news-font);\n    font-weight    : 700;\n    font-size      : 19px;\n    line-height    : 1.35;\n    letter-spacing : -.01em;\n    margin         : 0 0 12px;\n}\n\n.wp-news__title a {\n    color           : var(--news-ink);\n    text-decoration : none;\n    background-image: linear-gradient(var(--news-accent), var(--news-accent));\n    background-size : 0 1px;\n    background-repeat: no-repeat;\n    background-position: 0 100%;\n    transition      : color .2s ease-out, background-size .3s ease-out;\n}\n\n.wp-news__title a:hover,\n.wp-news__title a:focus {\n    color           : var(--news-accent);\n    background-size : 100% 1px;\n}\n\n.wp-news__excerpt {\n    font-family : var(--font-2);\n    font-size   : 15px;\n    line-height : 1.7;\n    color       : var(--news-text);\n    margin      : 0 0 20px;\n}\n\n.wp-news__link {\n    margin-top     : auto;\n    font-family    : var(--font-2);\n    font-size      : 12px;\n    font-weight    : 600;\n    text-transform : uppercase;\n    letter-spacing : 2px;\n    color          : var(--news-accent);\n    text-decoration: none;\n}\n\n.wp-news__link::after {\n    content     : \"\\2192\";\n    margin-left : 6px;\n    transition  : margin-left .2s ease-out;\n    display     : inline-block;\n}\n\n.wp-news__link:hover::after { margin-left: 12px; }\n\n/* --- bloque 1: una principal y tres laterales ---------------------------\n * Lo que en WordPress es \"1 main post with 3 side posts\": la entrada más\n * reciente manda con la imagen grande y las tres siguientes se apilan al\n * lado en formato compacto (miniatura cuadrada, sin resumen).\n * ---------------------------------------------------------------------- */\n.wp-news__lead {\n    display               : grid;\n    grid-template-columns : minmax(0, 1.55fr) minmax(0, 1fr);\n    gap                   : 32px;\n    align-items           : stretch;\n}\n\n.wp-news__lead[hidden] { display: none; }\n\n/* si el sitio sólo tiene una entrada, la principal se queda con todo el ancho */\n.wp-news__lead--solo { grid-template-columns: 1fr; }\n\n.wp-news__lead-side {\n    display       : grid;\n    grid-auto-rows: 1fr;\n    gap           : 24px;\n    min-width     : 0;\n}\n\n/* la principal */\n.wp-news__card--main .wp-news__thumb { aspect-ratio: 16 / 9; }\n\n.wp-news__card--main .wp-news__body { padding: 32px 36px 36px; }\n\n.wp-news__card--main .wp-news__title {\n    font-size   : clamp(24px, 2.4vw, 34px);\n    line-height : 1.18;\n    margin      : 0 0 16px;\n}\n\n.wp-news__card--main .wp-news__excerpt {\n    font-size : 17px;\n    max-width : 62ch;\n}\n\n/* las tres laterales. La miniatura pide ancho: la columna lateral estira las\n   tres tarjetas hasta igualar la altura de la principal, y con una columna\n   estrecha la foto salía recortada en vertical. */\n.wp-news__card--side {\n    display               : grid;\n    grid-template-columns : 190px minmax(0, 1fr);\n    flex-direction        : row;\n}\n\n.wp-news__card--side .wp-news__thumb {\n    aspect-ratio : auto;\n    height       : 100%;\n    min-height   : 110px;\n}\n\n.wp-news__card--side .wp-news__thumb--empty { font-size: 16px; }\n\n.wp-news__card--side .wp-news__body {\n    padding         : 18px 20px;\n    justify-content : center;\n}\n\n.wp-news__card--side .wp-news__title {\n    font-size   : 18px;\n    line-height : 1.3;\n    margin      : 0;\n}\n\n/* --- bloque 2: tres columnas, desplazadas 4 -----------------------------\n * El \"3 column post with 4 offset\": el mismo listado saltándose las cuatro\n * que ya salieron arriba, para que no se repita ninguna.\n * ---------------------------------------------------------------------- */\n.wp-news__section-title {\n    font-family    : \"Cinzel\", var(--font-1);\n    font-size      : 22px;\n    font-weight    : 600;\n    letter-spacing : .06em;\n    color          : var(--news-ink);\n    text-align     : center;\n    margin         : var(--vspace-2) 0 var(--vspace-0_5);\n}\n\n.wp-news__section-title[hidden] { display: none; }\n\n.wp-news__section-title::after {\n    content          : \"\";\n    display          : block;\n    width            : 60px;\n    height           : 2px;\n    background-color : var(--news-accent-2);\n    margin           : var(--vspace-0_5) auto 0;\n}\n\n.wp-news__grid {\n    display               : grid;\n    grid-template-columns : repeat(3, minmax(0, 1fr));\n    gap                   : 32px;\n    margin                : var(--vspace-1) 0 0;\n    padding               : 0;\n    list-style            : none;\n}\n\n/* --- estados: cargando, error, vacío ------------------------------------ */\n.wp-news__status {\n    font-family : var(--font-2);\n    font-size   : 15px;\n    color       : var(--news-soft);\n    text-align  : center;\n    padding     : var(--vspace-1) 0;\n}\n\n.wp-news__status[hidden] { display: none; }\n.wp-news__status--error  { color: var(--color-error-content); }\n\n.wp-news__retry {\n    margin-left     : 12px;\n    font-family     : var(--font-2);\n    font-size       : 14px;\n    font-weight     : 600;\n    color           : var(--news-accent);\n    background      : none;\n    border          : 0;\n    border-bottom   : 1px solid currentColor;\n    padding         : 0;\n    cursor          : pointer;\n    height          : auto;\n    line-height     : inherit;\n    text-transform  : none;\n    letter-spacing  : normal;\n}\n\n/* esqueletos mientras llega la primera tanda */\n.wp-news__skeleton {\n    background    : linear-gradient(100deg, var(--news-bd) 30%, #ece7d8 50%, var(--news-bd) 70%);\n    background-size: 400% 100%;\n    animation     : wp-news-shimmer 1.4s ease-in-out infinite;\n    min-height    : 300px;\n}\n\n.wp-news__skeleton--main { min-height: 460px; }\n.wp-news__skeleton--side { min-height: 110px; }\n\n@keyframes wp-news-shimmer {\n    from { background-position: 100% 0; }\n    to   { background-position: 0 0; }\n}\n\n/* --- pie del feed -------------------------------------------------------- */\n.wp-news__actions {\n    display         : flex;\n    justify-content : center;\n    margin-top      : var(--vspace-1);\n}\n\n.wp-news__more[hidden] { display: none; }\n\n.wp-news__more.btn--stroke {\n    border-color : var(--news-accent);\n    color        : var(--news-accent);\n    font-family  : var(--news-font);\n}\n\n.wp-news__more.btn--stroke:hover,\n.wp-news__more.btn--stroke:focus {\n    background-color : var(--news-accent);\n    border-color     : var(--news-accent);\n    color            : #ffffff;\n}\n\n.wp-news__foot {\n    text-align  : center;\n    font-family : var(--font-2);\n    font-size   : 13px;\n    color       : var(--news-soft);\n    margin      : var(--vspace-0_5) 0 0;\n}\n\n.wp-news__foot a { color: var(--news-accent); }\n\n/* aviso de entradas nuevas detectadas sin recargar la página */\n.wp-news__fresh {\n    display          : block;\n    margin           : 0 auto var(--vspace-0_5);\n    font-family      : var(--news-font);\n    font-size        : 14px;\n    font-weight      : 700;\n    color            : #ffffff;\n    background-color : var(--news-accent);\n    border           : 0;\n    border-radius    : 100px;\n    padding          : 10px 24px;\n    height           : auto;\n    line-height      : 1.4;\n    cursor           : pointer;\n    text-transform   : none;\n    letter-spacing   : normal;\n    box-shadow       : 0 6px 16px rgba(15, 18, 28, .12);\n}\n\n.wp-news__fresh[hidden] { display: none; }\n\n/* --- responsive ---------------------------------------------------------- */\n@media screen and (max-width: 1400px) {\n    .wp-news__lead { gap: 24px; }\n    .wp-news__grid { gap: 24px; }\n    .wp-news__card--side { grid-template-columns: 150px minmax(0, 1fr); }\n    .wp-news__card--side .wp-news__title { font-size: 16px; }\n}\n\n/* por debajo de esto la principal y las laterales ya no caben lado a lado */\n@media screen and (max-width: 1100px) {\n    .wp-news__lead { grid-template-columns: 1fr; }\n    .wp-news__lead-side { grid-auto-rows: auto; }\n    .wp-news__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    \n}\n\n@media screen and (max-width: 800px) {\n    .wp-news__grid { grid-template-columns: 1fr; }\n    .wp-news__card--main .wp-news__body { padding: 24px 24px 28px; }\n}\n\n@media screen and (max-width: 520px) {\n    .wp-news__card--side { grid-template-columns: 1fr; }\n    .wp-news__card--side .wp-news__thumb { aspect-ratio: 16 / 10; height: auto; }\n    .wp-news__card--side .wp-news__body { padding: 20px 22px 24px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .wp-news__card,\n    .wp-news__title a,\n    .wp-news__thumb img,\n    .wp-news__skeleton { transition: none; animation: none; }\n}\n</style>\n\n<div id=\"about\">\n<div class=\"wp-news\" id=\"wp-news\">\n\n    <button type=\"button\" class=\"wp-news__fresh\" id=\"wp-news-fresh\" hidden>\n        Hay publicaciones nuevas — actualizar\n    </button>\n\n    <div class=\"wp-news__lead\" id=\"wp-news-lead\"></div>\n\n    <h3 class=\"wp-news__section-title\" id=\"wp-news-grid-title\" hidden>\n        Más noticias\n    </h3>\n    <div class=\"wp-news__grid\" id=\"wp-news-grid\"></div>\n\n    <p class=\"wp-news__status\" id=\"wp-news-status\" role=\"status\" aria-live=\"polite\">\n        Cargando publicaciones…\n    </p>\n\n    <div class=\"wp-news__actions\">\n        <button type=\"button\" class=\"btn btn--stroke wp-news__more\" id=\"wp-news-more\" hidden>\n            Ver más publicaciones\n        </button>\n    </div>\n\n    <p class=\"wp-news__foot\" id=\"wp-news-foot\"></p>\n\n</div>\n</div>\n\n<script>\n(function () {\n        'use strict';\n\n        /* --- configuración --------------------------------------------------\n         * sitio     : '' = este mismo sitio (peticiones relativas).\n         * categoria : 11 = \"Santa Convocación\". Pon null para traer todas.\n         * destacadas: cuántas van al bloque de arriba (1 principal + 3 al lado).\n         *             Es también el `offset` del retículo de tres columnas.\n         * porPagina : cuántas tarjetas trae cada tanda del retículo.\n         * refrescoMs: cada cuánto se comprueba si hay entradas nuevas.\n         * ------------------------------------------------------------------- */\n        var CFG = {\n            sitio      : '',\n            categoria  : 11,\n            destacadas : 4,\n            porPagina  : 6,\n            refrescoMs : 5 * 60 * 1000\n        };\n\n        var lead       = document.getElementById('wp-news-lead');\n        var grid       = document.getElementById('wp-news-grid');\n        var gridTitulo = document.getElementById('wp-news-grid-title');\n        var status     = document.getElementById('wp-news-status');\n        var more       = document.getElementById('wp-news-more');\n        var fresh      = document.getElementById('wp-news-fresh');\n        var foot       = document.getElementById('wp-news-foot');\n\n        if (!lead || !grid) { return; }\n\n        var state = {\n            enRejilla    : 0,     // cuántas hay pintadas en las tres columnas\n            enDestacadas : 0,\n            total        : 0,\n            masReciente  : null,  // id de la entrada más nueva conocida\n            cargando     : false,\n            ultimaMirada : 0\n        };\n\n        /* --- utilidades ----------------------------------------------------- */\n\n        // WordPress devuelve HTML ya renderizado (con entidades tipo &#8230;).\n        // Lo pasamos por un nodo suelto para quedarnos solo con el texto.\n        var scratch = document.createElement('div');\n        function aTexto(html) {\n            scratch.innerHTML = html || '';\n            return (scratch.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n\n        function recortar(texto, max) {\n            if (texto.length <= max) { return texto; }\n            var corte = texto.slice(0, max);\n            var esp = corte.lastIndexOf(' ');\n            return (esp > max * 0.6 ? corte.slice(0, esp) : corte) + '…';\n        }\n\n        function fecha(iso) {\n            var d = new Date(iso);\n            if (isNaN(d)) { return ''; }\n            try {\n                return d.toLocaleDateString('es-ES', {\n                    day: 'numeric', month: 'long', year: 'numeric'\n                });\n            } catch (e) {\n                return d.toISOString().slice(0, 10);\n            }\n        }\n\n        function imagen(post) {\n            var emb = post._embedded && post._embedded['wp:featuredmedia'];\n            var media = emb && emb[0];\n            if (!media || media.code) { return null; }   // code = error de permisos\n            var sizes = (media.media_details && media.media_details.sizes) || {};\n            var pick = sizes.medium_large || sizes.large || sizes.medium || null;\n            return {\n                src: (pick && pick.source_url) || media.source_url || null,\n                alt: aTexto(media.alt_text || '')\n            };\n        }\n\n        /* La API acepta `offset` en vez de `page`, y es lo que necesita el\n         * segundo bloque: siempre pide desde la quinta entrada en adelante. */\n        function url(desde, cuantas) {\n            var q = [\n                'per_page=' + cuantas,\n                'offset=' + desde,\n                'orderby=date',\n                'order=desc',\n                '_embed=wp:featuredmedia',\n                '_fields=id,link,date,title,excerpt,_links'\n            ];\n            if (CFG.categoria) { q.push('categories=' + CFG.categoria); }\n            return CFG.sitio + '/wp-json/wp/v2/posts?' + q.join('&');\n        }\n\n        function traer(desde, cuantas) {\n            return fetch(url(desde, cuantas), { credentials: 'omit' })\n                .then(function (r) {\n                    if (!r.ok) { throw new Error('HTTP ' + r.status); }\n                    return r.json().then(function (datos) {\n                        return {\n                            posts : datos,\n                            total : parseInt(r.headers.get('X-WP-Total'), 10) || datos.length\n                        };\n                    });\n                });\n        }\n\n        /* --- pintado -------------------------------------------------------- */\n\n        function miniatura(post, oculta) {\n            var enlace = document.createElement('a');\n            enlace.className = 'wp-news__thumb';\n            enlace.href = post.link;\n            if (oculta) {\n                enlace.setAttribute('aria-hidden', 'true');\n                enlace.setAttribute('tabindex', '-1');\n            }\n\n            var img = imagen(post);\n            if (img && img.src) {\n                var el = document.createElement('img');\n                el.src = img.src;\n                el.alt = img.alt || '';\n                el.loading = 'lazy';\n                el.decoding = 'async';\n                enlace.appendChild(el);\n            } else {\n                enlace.className += ' wp-news__thumb--empty';\n                enlace.textContent = 'LLDM';\n            }\n            return enlace;\n        }\n\n        /* variante: 'main' (la grande), 'side' (las tres de al lado, sin\n         * resumen, como en el original) o 'grid' (las tres columnas). */\n        function tarjeta(post, variante) {\n            var art = document.createElement('article');\n            art.className = 'wp-news__card wp-news__card--' + variante;\n\n            var titulo = aTexto(post.title && post.title.rendered) || 'Sin título';\n            var conResumen = variante !== 'side';\n            var resumen = conResumen\n                ? recortar(aTexto(post.excerpt && post.excerpt.rendered), variante === 'main' ? 260 : 150)\n                : '';\n\n            var cuerpo = document.createElement('div');\n            cuerpo.className = 'wp-news__body';\n\n            var f = document.createElement('p');\n            f.className = 'wp-news__date';\n            f.textContent = fecha(post.date);\n\n            var h = document.createElement(variante === 'main' ? 'h3' : 'h4');\n            h.className = 'wp-news__title';\n            var ha = document.createElement('a');\n            ha.href = post.link;\n            ha.textContent = titulo;\n            h.appendChild(ha);\n\n            cuerpo.appendChild(f);\n            cuerpo.appendChild(h);\n\n            if (resumen) {\n                var p = document.createElement('p');\n                p.className = 'wp-news__excerpt';\n                p.textContent = resumen;\n                cuerpo.appendChild(p);\n            }\n\n            if (conResumen) {\n                var leer = document.createElement('a');\n                leer.className = 'wp-news__link';\n                leer.href = post.link;\n                leer.textContent = 'Leer publicación';\n                leer.setAttribute('aria-label', 'Leer publicación: ' + titulo);\n                cuerpo.appendChild(leer);\n            }\n\n            art.appendChild(miniatura(post, true));\n            art.appendChild(cuerpo);\n            return art;\n        }\n\n        // bloque 1: la primera manda, las tres siguientes se apilan al lado\n        function pintarDestacadas(posts) {\n            lead.innerHTML = '';\n            lead.hidden = !posts.length;\n            state.enDestacadas = posts.length;\n            if (!posts.length) { return; }\n\n            lead.appendChild(tarjeta(posts[0], 'main'));\n\n            var laterales = posts.slice(1, CFG.destacadas);\n            lead.classList.toggle('wp-news__lead--solo', !laterales.length);\n            if (!laterales.length) { return; }\n\n            var col = document.createElement('div');\n            col.className = 'wp-news__lead-side';\n            laterales.forEach(function (post) { col.appendChild(tarjeta(post, 'side')); });\n            lead.appendChild(col);\n        }\n\n        // bloque 2: tres columnas con el resto\n        function pintarRejilla(posts, anexar) {\n            if (!anexar) { grid.innerHTML = ''; state.enRejilla = 0; }\n            var frag = document.createDocumentFragment();\n            posts.forEach(function (post) { frag.appendChild(tarjeta(post, 'grid')); });\n            grid.appendChild(frag);\n            state.enRejilla += posts.length;\n            gridTitulo.hidden = !state.enRejilla;\n        }\n\n        function esqueletos() {\n            var main = document.createElement('div');\n            main.className = 'wp-news__skeleton wp-news__skeleton--main';\n            var col = document.createElement('div');\n            col.className = 'wp-news__lead-side';\n            for (var i = 0; i < CFG.destacadas - 1; i++) {\n                var s = document.createElement('div');\n                s.className = 'wp-news__skeleton wp-news__skeleton--side';\n                col.appendChild(s);\n            }\n            lead.hidden = false;\n            lead.appendChild(main);\n            lead.appendChild(col);\n\n            var frag = document.createDocumentFragment();\n            for (var j = 0; j < CFG.porPagina; j++) {\n                var g = document.createElement('div');\n                g.className = 'wp-news__skeleton';\n                frag.appendChild(g);\n            }\n            grid.appendChild(frag);\n        }\n\n        function limpiarEsqueletos() {\n            var s = document.querySelectorAll('.wp-news__skeleton');\n            for (var i = 0; i < s.length; i++) { s[i].parentNode.removeChild(s[i]); }\n            var vacia = lead.querySelector('.wp-news__lead-side:empty');\n            if (vacia) { vacia.parentNode.removeChild(vacia); }\n        }\n\n        function mensaje(texto, esError, conReintento) {\n            status.hidden = !texto;\n            status.textContent = texto || '';\n            status.className = 'wp-news__status' + (esError ? ' wp-news__status--error' : '');\n            if (conReintento) {\n                var b = document.createElement('button');\n                b.type = 'button';\n                b.className = 'wp-news__retry';\n                b.textContent = 'Reintentar';\n                b.addEventListener('click', function () {\n                    if (state.enDestacadas) { cargarMas(); } else { cargar(); }\n                });\n                status.appendChild(b);\n            }\n        }\n\n        function mostradas() {\n            return state.enDestacadas + state.enRejilla;\n        }\n\n        function pie() {\n            if (!state.total) { foot.textContent = ''; return; }\n            foot.textContent = 'Mostrando ' + mostradas() + ' de ' + state.total + ' publicaciones · ';\n            var a = document.createElement('a');\n            a.href = CFG.sitio || '/';\n            a.textContent = 'ver el sitio completo';\n            foot.appendChild(a);\n        }\n\n        function repasarBotonMas() {\n            more.hidden = mostradas() >= state.total;\n        }\n\n        /* --- carga ----------------------------------------------------------- */\n\n        // primera pasada: una sola petición trae las destacadas y la primera\n        // tanda del retículo, y de ahí se reparten.\n        function cargar() {\n            if (state.cargando) { return; }\n            state.cargando = true;\n            more.disabled = true;\n\n            lead.innerHTML = '';\n            grid.innerHTML = '';\n            state.enRejilla = 0;\n            state.enDestacadas = 0;\n            esqueletos();\n            mensaje('Cargando publicaciones…');\n\n            traer(0, CFG.destacadas + CFG.porPagina).then(function (res) {\n                limpiarEsqueletos();\n                state.total = res.total;\n                state.ultimaMirada = Date.now();\n\n                if (!res.posts.length) {\n                    lead.hidden = true;\n                    gridTitulo.hidden = true;\n                    mensaje('Todavía no hay publicaciones.');\n                    more.hidden = true;\n                    foot.textContent = '';\n                    return;\n                }\n\n                state.masReciente = res.posts[0].id;\n\n                pintarDestacadas(res.posts.slice(0, CFG.destacadas));\n                pintarRejilla(res.posts.slice(CFG.destacadas), false);\n\n                mensaje('');\n                repasarBotonMas();\n                fresh.hidden = true;\n                pie();\n            }).catch(function (err) {\n                limpiarEsqueletos();\n                lead.hidden = !state.enDestacadas;\n                mensaje('No se pudieron cargar las publicaciones (' + err.message + ').', true, true);\n            }).then(function () {\n                state.cargando = false;\n                more.disabled = false;\n            });\n        }\n\n        // siguientes tandas: sólo el retículo, desplazado por lo ya pintado\n        function cargarMas() {\n            if (state.cargando) { return; }\n            state.cargando = true;\n            more.disabled = true;\n            mensaje('Cargando más…');\n\n            traer(CFG.destacadas + state.enRejilla, CFG.porPagina).then(function (res) {\n                state.total = res.total;\n                pintarRejilla(res.posts, true);\n                mensaje('');\n                repasarBotonMas();\n                pie();\n            }).catch(function () {\n                mensaje('No se pudieron cargar más publicaciones.', true, true);\n            }).then(function () {\n                state.cargando = false;\n                more.disabled = false;\n            });\n        }\n\n        /* --- ¿hay algo nuevo? -------------------------------------------------\n         * Se pregunta por la entrada más reciente (1 sola) y se compara el id.\n         * Si el visitante sigue en la primera tanda, se refresca sin avisar;\n         * si ya pulsó \"ver más\", se le ofrece el botón para no moverle el suelo.\n         * --------------------------------------------------------------------- */\n        function mirarNovedades() {\n            if (state.cargando || document.hidden || !state.masReciente) { return; }\n            state.ultimaMirada = Date.now();\n\n            traer(0, 1).then(function (res) {\n                var nuevo = res.posts[0];\n                if (!nuevo || nuevo.id === state.masReciente) {\n                    if (res.total !== state.total) {\n                        state.total = res.total;\n                        repasarBotonMas();\n                        pie();\n                    }\n                    return;\n                }\n                if (state.enRejilla <= CFG.porPagina) {\n                    cargar();                   // aún en la primera tanda: recarga limpia\n                } else {\n                    fresh.hidden = false;       // ya navegó: que decida él\n                }\n            }).catch(function () { /* sin conexión: se reintenta al siguiente ciclo */ });\n        }\n\n        /* --- arranque -------------------------------------------------------- */\n\n        more.addEventListener('click', cargarMas);\n\n        fresh.addEventListener('click', function () {\n            fresh.hidden = true;\n            cargar();\n            document.getElementById('about').scrollIntoView({ behavior: 'smooth', block: 'start' });\n        });\n\n        setInterval(mirarNovedades, CFG.refrescoMs);\n\n        // al volver a la pestaña, si hace rato que no se mira, se comprueba ya\n        document.addEventListener('visibilitychange', function () {\n            if (!document.hidden && Date.now() - state.ultimaMirada > 60000) { mirarNovedades(); }\n        });\n        window.addEventListener('online', mirarNovedades);\n\n        cargar();\n    })();\n</script>"
       },
